# rpsd-ingest development defaults.
# For standalone local dev: cp .env.development .env
# For rpsd-orchestrated dev: rpsd's setup.sh generates .env from this file.
#
# IMPORTANT: shared services (Kafka, RabbitMQ, Prefect) are NOT started by rpsd-ingest.
# Start them from the rpsd repo first: rpsd/scripts/start-shared.sh

# =============================================================================
# EXTERNAL ACCESS (how users reach the app)
# =============================================================================

EXTERNAL_SCHEME=http
EXTERNAL_HOST=localhost
EXTERNAL_PORT=20000

# =============================================================================
# TRANSPORT SETTINGS
# =============================================================================

# API key for authentication (required)
# Used in Authorization: Bearer <key> or X-API-Key: <key> headers
TRANSPORT__API_KEY=dev-api-key

# =============================================================================
# STORAGE SETTINGS
# =============================================================================

# Storage provider: fs (filesystem) or s3
STORAGE__PROVIDER=fs

# --- Filesystem Storage (when PROVIDER=fs) ---

# Skip saving when content is identical to the latest stored version
STORAGE__COMPARE_BEFORE_SAVE=true

# Base directory for storing files
STORAGE__FS__BASE_PATH=/tmp/rpsd-storage

# --- S3 Storage (when PROVIDER=s3) ---

# S3 bucket name
# STORAGE__S3__BUCKET_NAME=my-bucket-name

# Storage structure (filesystem):
#   {base_path}/{who}/{what}/{uuid}.{extension}
#   {base_path}/{who}/{what}/{uuid}.{extension}.meta
#
# Storage structure (S3):
#   s3://{bucket}/{who}/{what}/{uuid}.{extension}
#
# AWS credentials for S3:
#   Configure via standard AWS methods (env vars, credentials file, IAM role)
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION

# =============================================================================
# FORWARDING SETTINGS (disabled by default)
# =============================================================================

# This forwards processed messages to a message broker after saving to storage.
# Set FORWARD__CARRIER to enable: kafka | rabbitmq | http

# Carrier type
# FORWARD__CARRIER=kafka

# Target recipient (Kafka topic name or HTTP URL)
# FORWARD__RECIPIENT=enriched-events

# Forward mode:
#   fatheavy - Forward storage URL reference (efficient, recommended)
#   slimfast - Forward content inline (self-contained, larger messages)
# FORWARD__MODE=fatheavy

# --- Kafka Settings (when CARRIER=kafka) ---

# Kafka is started by rpsd (start-shared.sh) and exposed on the host at port 19000.
# The app runs inside the devcontainer, so the host is reached via host.docker.internal.
# FORWARD__KAFKA__BOOTSTRAP_SERVERS=host.docker.internal:19000

# Optional client identifier for this application
# FORWARD__KAFKA__CLIENT_ID=rpsd-ingest

# --- RabbitMQ Settings (when CARRIER=rabbitmq) ---

# RabbitMQ is started by rpsd (start-shared.sh) and exposed on the host at port 19100.
# The app runs inside the devcontainer, so the host is reached via host.docker.internal.
# FORWARD__RABBITMQ__URL=amqp://guest:guest@host.docker.internal:19100/

# Exchange name (empty = default exchange)
# FORWARD__RABBITMQ__EXCHANGE=

# Exchange type (direct, fanout, topic, headers)
# FORWARD__RABBITMQ__EXCHANGE_TYPE=direct

# Queue durability
# FORWARD__RABBITMQ__QUEUE_DURABLE=true

# QoS prefetch count
# FORWARD__RABBITMQ__PREFETCH_COUNT=10

# =============================================================================
# CONSUMER SETTINGS (disabled by default)
# =============================================================================

# Separate settings for consuming messages (separation of concerns:
# publishing vs. consuming). Set CONSUMER__CARRIER to enable: kafka | rabbitmq

# Carrier type
# CONSUMER__CARRIER=kafka

# Topic/queue to consume from
# CONSUMER__TOPIC=enriched-events

# --- Kafka Consumer Settings (when CARRIER=kafka) ---

# Kafka broker connection (see Kafka note above — host.docker.internal:19000)
# CONSUMER__KAFKA__BOOTSTRAP_SERVERS=host.docker.internal:19000

# Consumer group ID (REQUIRED for Kafka consuming)
# CONSUMER__KAFKA__GROUP_ID=rpsd-ingest-consumer

# Optional client identifier
# CONSUMER__KAFKA__CLIENT_ID=rpsd-ingest-consumer

# --- RabbitMQ Consumer Settings (when CARRIER=rabbitmq) ---

# RabbitMQ broker connection (see RabbitMQ note above — host.docker.internal:19100)
# CONSUMER__RABBITMQ__URL=amqp://guest:guest@host.docker.internal:19100/

# Exchange name (empty = default exchange)
# CONSUMER__RABBITMQ__EXCHANGE=

# Exchange type (direct, fanout, topic, headers)
# CONSUMER__RABBITMQ__EXCHANGE_TYPE=direct

# Queue durability
# CONSUMER__RABBITMQ__QUEUE_DURABLE=true

# QoS prefetch count
# CONSUMER__RABBITMQ__PREFETCH_COUNT=10

# =============================================================================
# FLOW INVOCATION SETTINGS (disabled by default)
# =============================================================================

# Invoke a Prefect Flow deployment after saving to storage.
# Requires a running Prefect server and a served deployment.

# Deployment name in "flow-name/deployment-name" format.
# When set, the app invokes this deployment after each ingest.
# When commented out (default), flow invocation is disabled.
# FLOW__DEPLOYMENT=ingest-flow/ingest-deployment

# Timeout in seconds for flow completion.
# Default (0) = fire-and-forget: trigger and return immediately.
# Set to a positive number to wait for the flow run to finish:
# FLOW__TIMEOUT=0

# Prefect API URL (required when flow invocation is enabled).
# Prefect is started by rpsd (start-shared.sh) and exposed on the host at port 19200.
# The app runs inside the devcontainer, so the host is reached via host.docker.internal.
# PREFECT_API_URL=http://host.docker.internal:19200/api

# =============================================================================
# EXCHANGE AGREEMENT API (rpsd-config)
# =============================================================================

# URL template for fetching a contract's flow profile from rpsd-config.
# {contract_code} is replaced at runtime (validated and URL-encoded).
# rpsd-config is started by rpsd (start-shared.sh) and exposed on the host at port 20100.
# The app runs inside the devcontainer, so the host is reached via host.docker.internal.
# EXCHANGE_AGREEMENT__FLOW_PROFILE_URL=http://host.docker.internal:20100/exchange_agreement/api/v1/contracts/{contract_code}/flow-profile

# =============================================================================
# MESSAGE BROKER INFRASTRUCTURE
# =============================================================================

# Kafka, RabbitMQ, and Prefect are all started by rpsd via start-shared.sh.
# Run from the rpsd repo root (from host, not devcontainer):
#   rpsd/scripts/start-shared.sh
#
# Addresses from inside the devcontainer (host.docker.internal = Docker host):
#   Kafka broker:       host.docker.internal:19000
#   Kafka UI:           http://localhost:19010  (browser on host)
#   Schema Registry:    http://localhost:19020  (browser on host)
#   RabbitMQ broker:    amqp://guest:guest@host.docker.internal:19100/
#   RabbitMQ UI:        http://localhost:19110  (browser on host, guest/guest)
#   Prefect API:        http://host.docker.internal:19200/api
#   Prefect UI:         http://localhost:19200  (browser on host)
