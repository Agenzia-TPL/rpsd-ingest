# FastAPI Ingest Example - Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: The .env file must be in your current working directory
# when running the app. Run from the example directory:
#   cd examples/fastapi_ingest_app
#   uv run fastapi-ingest-app
#
# Alternatively, export these variables directly in your shell.

# =============================================================================
# TRANSPORT SETTINGS
# =============================================================================

# API key for authentication (required)
# Used in Authorization: Bearer <key> or X-API-Key: <key> headers
APP__TRANSPORT__API_KEY=your-secret-key-here

# =============================================================================
# STORAGE SETTINGS
# =============================================================================

# Storage provider: fs (filesystem) or s3
APP__STORAGE__PROVIDER=fs

# --- Filesystem Storage (when PROVIDER=fs) ---

# Base directory for storing files
APP__STORAGE__FS__BASE_PATH=/tmp/rpsd-storage

# --- S3 Storage (when PROVIDER=s3) ---

# S3 bucket name
# APP__STORAGE__S3__BUCKET_NAME=my-bucket-name

# =============================================================================
# NOTES
# =============================================================================

# Storage structure (filesystem):
#   {base_path}/{who}/{what}/{uuid}.{extension}
#   {base_path}/{who}/{what}/{uuid}.{extension}.meta
#
# Storage structure (S3):
#   s3://{bucket}/{who}/{what}/{uuid}.{extension}
#
# AWS credentials for S3:
#   Configure via standard AWS methods (env vars, credentials file, IAM role)
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION

# =============================================================================
# FORWARDING SETTINGS (Optional)
# =============================================================================

# Enable Kafka forwarding by uncommenting the following lines:
# This forwards processed messages to a Kafka topic after saving to storage

# Carrier type (kafka or http)
# APP__FORWARD__CARRIER=kafka

# Target recipient (Kafka topic name or HTTP URL)
# APP__FORWARD__RECIPIENT=enriched-events

# Forward mode:
#   fatheavy - Forward storage URL reference (efficient, recommended)
#   slimfast - Forward content inline (self-contained, larger messages)
# APP__FORWARD__MODE=fatheavy

# --- Kafka Settings (when CARRIER=kafka) ---

# Kafka broker connection:
#   From devcontainer: use host.docker.internal:9092
#   From host machine: use localhost:9092
# APP__FORWARD__KAFKA__BOOTSTRAP_SERVERS=host.docker.internal:9092

# Optional client identifier for this application
# APP__FORWARD__KAFKA__CLIENT_ID=fastapi-forwarder

# =============================================================================
# KAFKA INFRASTRUCTURE
# =============================================================================

# To use Kafka forwarding, you must start Kafka infrastructure first:
#   (From host machine, not devcontainer)
#   cd ../../host-scripts
#   ./kafka-start.sh
#
# This provides:
#   - Kafka broker at localhost:9092 (host) / host.docker.internal:9092 (devcontainer)
#   - Kafka UI at http://localhost:8080
#   - Schema Registry at http://localhost:8081
#
# To stop Kafka:
#   ./kafka-stop.sh
