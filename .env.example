# FastAPI Ingest Example - Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: The .env file must be in your current working directory
# when running the app. Run from the example directory:
#   cd examples/fastapi_ingest_app
#   uv run fastapi-ingest-app
#
# Alternatively, export these variables directly in your shell.

# =============================================================================
# TRANSPORT SETTINGS
# =============================================================================

# API key for authentication (required)
# Used in Authorization: Bearer <key> or X-API-Key: <key> headers
APP__TRANSPORT__API_KEY=your-secret-key-here

# =============================================================================
# STORAGE SETTINGS
# =============================================================================

# Storage provider: fs (filesystem) or s3
APP__STORAGE__PROVIDER=fs

# --- Filesystem Storage (when PROVIDER=fs) ---

# Skip saving when content is identical to the latest stored version
APP__STORAGE__COMPARE_BEFORE_SAVE=true

# Base directory for storing files
APP__STORAGE__FS__BASE_PATH=/tmp/rpsd-storage

# --- S3 Storage (when PROVIDER=s3) ---

# S3 bucket name
# APP__STORAGE__S3__BUCKET_NAME=my-bucket-name

# =============================================================================
# NOTES
# =============================================================================

# Storage structure (filesystem):
#   {base_path}/{who}/{what}/{uuid}.{extension}
#   {base_path}/{who}/{what}/{uuid}.{extension}.meta
#
# Storage structure (S3):
#   s3://{bucket}/{who}/{what}/{uuid}.{extension}
#
# AWS credentials for S3:
#   Configure via standard AWS methods (env vars, credentials file, IAM role)
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION

# =============================================================================
# FORWARDING SETTINGS (Optional)
# =============================================================================

# Enable Kafka forwarding by uncommenting the following lines:
# This forwards processed messages to a Kafka topic after saving to storage

# Carrier type (kafka, rabbitmq, or http)
# APP__FORWARD__CARRIER=kafka

# Target recipient (Kafka topic name or HTTP URL)
# APP__FORWARD__RECIPIENT=enriched-events

# Forward mode:
#   fatheavy - Forward storage URL reference (efficient, recommended)
#   slimfast - Forward content inline (self-contained, larger messages)
# APP__FORWARD__MODE=fatheavy

# --- Kafka Settings (when CARRIER=kafka) ---

# Kafka broker connection:
#   From devcontainer: use host.docker.internal:9092
#   From host machine: use localhost:9092
# APP__FORWARD__KAFKA__BOOTSTRAP_SERVERS=host.docker.internal:9092

# Consumer group ID (required for consuming, used by consumer.py)
# APP__FORWARD__KAFKA__GROUP_ID=demo-consumer

# Optional client identifier for this application
# APP__FORWARD__KAFKA__CLIENT_ID=fastapi-forwarder

# --- RabbitMQ Settings (when CARRIER=rabbitmq) ---

# RabbitMQ broker connection:
#   From devcontainer: use amqp://guest:guest@host.docker.internal/
#   From host machine: use amqp://guest:guest@localhost/
# APP__FORWARD__RABBITMQ__URL=amqp://guest:guest@host.docker.internal/

# Exchange name (empty = default exchange)
# APP__FORWARD__RABBITMQ__EXCHANGE=

# Exchange type (direct, fanout, topic, headers)
# APP__FORWARD__RABBITMQ__EXCHANGE_TYPE=direct

# Queue durability
# APP__FORWARD__RABBITMQ__QUEUE_DURABLE=true

# QoS prefetch count
# APP__FORWARD__RABBITMQ__PREFETCH_COUNT=10

# =============================================================================
# CONSUMER SETTINGS (for consumer.py script)
# =============================================================================

# Separate settings for consuming messages (demonstrates separation of concerns)
# The consumer script (consumer.py) uses these settings, while the FastAPI app
# uses FORWARD settings above for publishing.

# Carrier type (kafka or rabbitmq)
# APP__CONSUMER__CARRIER=kafka

# Topic/queue to consume from
# APP__CONSUMER__TOPIC=enriched-events

# --- Kafka Consumer Settings (when CARRIER=kafka) ---

# Kafka broker connection
# APP__CONSUMER__KAFKA__BOOTSTRAP_SERVERS=host.docker.internal:9092

# Consumer group ID (REQUIRED for Kafka consuming)
# APP__CONSUMER__KAFKA__GROUP_ID=demo-consumer

# Optional client identifier
# APP__CONSUMER__KAFKA__CLIENT_ID=fastapi-consumer

# --- RabbitMQ Consumer Settings (when CARRIER=rabbitmq) ---

# RabbitMQ broker connection
# APP__CONSUMER__RABBITMQ__URL=amqp://guest:guest@host.docker.internal/

# Exchange name (empty = default exchange)
# APP__CONSUMER__RABBITMQ__EXCHANGE=

# Exchange type (direct, fanout, topic, headers)
# APP__CONSUMER__RABBITMQ__EXCHANGE_TYPE=direct

# Queue durability
# APP__CONSUMER__RABBITMQ__QUEUE_DURABLE=true

# QoS prefetch count
# APP__CONSUMER__RABBITMQ__PREFETCH_COUNT=10

# =============================================================================
# FLOW INVOCATION SETTINGS (Optional)
# =============================================================================

# Invoke a Prefect Flow deployment after saving to storage.
# Requires a running Prefect server and a served deployment.

# Deployment name in "flow-name/deployment-name" format.
# When set, the app invokes this deployment after each ingest.
# When commented out (default), flow invocation is disabled.
# APP__FLOW__DEPLOYMENT=ingest-flow/ingest-deployment

# Timeout in seconds for flow completion.
# Default (unset) = fire-and-forget: trigger and return immediately.
# Set to a number to wait for the flow run to finish:
# APP__FLOW__TIMEOUT=60.0

# --- Prefect Server Connection ---

# Prefect API URL (required when Prefect server is running):
#   From devcontainer: http://host.docker.internal:4200/api
#   From host machine: http://localhost:4200/api
# PREFECT_API_URL=http://host.docker.internal:4200/api

# =============================================================================
# MESSAGE BROKER INFRASTRUCTURE
# =============================================================================

# To use Kafka or RabbitMQ forwarding, you must start the broker first:
#   (From host machine, not devcontainer)
#   cd ../../host-scripts
#
# For Kafka:
#   ./kafka-start.sh
#   - Kafka broker at localhost:9092 (host) / host.docker.internal:9092 (devcontainer)
#   - Kafka UI at http://localhost:8080
#   - Schema Registry at http://localhost:8081
#   ./kafka-stop.sh  # To stop
#
# For RabbitMQ:
#   ./rabbitmq-start.sh
#   - RabbitMQ broker at amqp://localhost/ (host) / amqp://host.docker.internal/ (devcontainer)
#   - Management UI at http://localhost:15672 (guest/guest)
#   ./rabbitmq-stop.sh  # To stop
