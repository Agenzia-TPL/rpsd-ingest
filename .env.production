# rpsd-ingest production defaults.
# Used by Swarm (env_file:) and K8s (configMapGenerator).
# Coordination vars are overridden by the deployment layer.

# --- External access ---
EXTERNAL_SCHEME=https
EXTERNAL_HOST=
EXTERNAL_PORT=443

# --- Transport ---
TRANSPORT__API_KEY=

# --- Storage ---
STORAGE__PROVIDER=fs
STORAGE__FS__BASE_PATH=/tmp/rpsd-storage
STORAGE__COMPARE_BEFORE_SAVE=true

# --- Forwarding (configure per deployment) ---
# FORWARD__CARRIER=kafka
# FORWARD__RECIPIENT=enriched-events
# FORWARD__MODE=fatheavy
# FORWARD__KAFKA__BOOTSTRAP_SERVERS=kafka:9092
# FORWARD__KAFKA__CLIENT_ID=rpsd-ingest
# FORWARD__RABBITMQ__URL=amqp://guest:guest@rabbitmq/

# --- Consumer (configure per deployment) ---
# CONSUMER__CARRIER=kafka
# CONSUMER__TOPIC=enriched-events
# CONSUMER__KAFKA__BOOTSTRAP_SERVERS=kafka:9092
# CONSUMER__KAFKA__GROUP_ID=rpsd-ingest-consumer
# CONSUMER__RABBITMQ__URL=amqp://guest:guest@rabbitmq/

# --- Flow invocation (configure per deployment) ---
# FLOW__DEPLOYMENT=ingest-flow/ingest-deployment
# FLOW__TIMEOUT=0
# PREFECT_API_URL=http://prefect:4200/api

# --- Exchange agreement (configure per deployment) ---
# EXCHANGE_AGREEMENT__TOKEN_URL=http://keycloak:8080/realms/rpsd/protocol/openid-connect/token
# EXCHANGE_AGREEMENT__FLOW_PROFILE_URL=http://rpsd-config:8000/exchange_agreement/api/v1/contracts/{contract_code}/flow-profile

# --- JWT authentication hardening ---
# JWT_AUTH__ENABLED=true
# JWT_AUTH__ISSUER_URL=http://keycloak:8080/realms/rpsd
# JWT_AUTH__AUDIENCE=rpsd-ingest
# JWT_AUTH__JWKS_URL=http://keycloak:8080/realms/rpsd/protocol/openid-connect/certs
# JWT_AUTH__ALGORITHMS=["RS256"]
# JWT_AUTH__LEEWAY_SECONDS=0

# --- Internal authz check (ingest -> rpsd-config) ---
# CONFIG_AUTHZ__URL=http://rpsd-config:8000/internal/authz/check
# CONFIG_AUTHZ__TIMEOUT_SECONDS=5
# CONFIG_AUTHZ__VERIFY_TLS=true
# CONFIG_AUTHZ__TOKEN_URL=http://keycloak:8080/realms/rpsd/protocol/openid-connect/token
# CONFIG_AUTHZ__CLIENT_ID=rpsd-ingest
# CONFIG_AUTHZ__CLIENT_SECRET=
# CONFIG_AUTHZ__AUDIENCE=rpsd-config-internal
